{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::git-viewspace-fs::cli-foreground",
  "labels": [
    "host"
  ],
  "prerequisites": [
    "command:python3",
    "linux",
    "python-module:python3:cffi",
    "python-module:python3:fuse",
    "python-module:python3:pygit2"
  ],
  "config": {
    "argv": [
      "python3",
      "{repository}/utils/run_git_viewspace_fs_unittests.py",
      "{repository}",
      "{workspace}",
      "--",
      "git_viewspace_fs.tests.cli_test.CLIInvocationTestCase.test_module_main_runs_in_foreground_with_absolute_paths_and_mount_options"
    ],
    "cwd": {
      "anchor": "workspace",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "timeout_seconds": 60,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
