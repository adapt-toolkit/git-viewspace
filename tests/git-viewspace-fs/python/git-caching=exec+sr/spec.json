{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::git-viewspace-fs::git-caching",
  "labels": [
    "host"
  ],
  "prerequisites": [
    "command:git",
    "command:python3",
    "linux",
    "python-module:python3:cffi",
    "python-module:python3:pygit2"
  ],
  "config": {
    "argv": [
      "python3",
      "{repository}/utils/run_git_viewspace_fs_unittests.py",
      "{repository}",
      "{workspace}",
      "--fixture",
      "--",
      "git_viewspace_fs.tests.gitoper_test.GitOperationsTestCase.test_successful_commit_and_entry_lookups_are_cached",
      "git_viewspace_fs.tests.gitoper_test.GitOperationsTestCase.test_failed_entry_lookup_is_not_cached",
      "git_viewspace_fs.tests.gitoper_test.GitOperationsTestCase.test_sibling_entries_share_the_cached_parent_tree"
    ],
    "cwd": {
      "anchor": "workspace",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "timeout_seconds": 60,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
