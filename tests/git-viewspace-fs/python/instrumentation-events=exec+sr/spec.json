{
  "schema_version": 2,
  "scope": "basic",
  "driver": "exec",
  "selector": "python::git-viewspace-fs::instrumentation-events",
  "labels": [],
  "prerequisites": [
    "command:python3",
    "linux"
  ],
  "config": {
    "argv": [
      "python3",
      "{repository}/utils/run_git_viewspace_fs_unittests.py",
      "{repository}",
      "{workspace}",
      "--",
      "git_viewspace_fs.tests.instrumentation_test.JsonlInstrumentationTestCase.test_events_are_ordered_counted_and_source_identified"
    ],
    "cwd": {
      "anchor": "workspace",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "timeout_seconds": 60,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
