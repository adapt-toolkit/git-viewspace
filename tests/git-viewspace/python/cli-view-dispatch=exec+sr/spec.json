{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::git-viewspace::cli-view-dispatch",
  "labels": [],
  "prerequisites": [
    "command:git",
    "command:python3"
  ],
  "config": {
    "argv": [
      "python3",
      "-m",
      "unittest",
      "tests.test_stage2.Stage2Test.test_cli_dispatches_nested_readonly_view_command",
      "tests.test_stage2.Stage2Test.test_cli_dispatches_overlay_init_clean_and_deinit",
      "tests.test_stage2.Stage2Test.test_cli_dispatches_view_sync",
      "tests.test_stage2.Stage2Test.test_cli_dispatches_compound_view_commands"
    ],
    "cwd": {
      "anchor": "repository",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "apps/git-viewspace",
        "TMPDIR": "{workspace}"
      }
    },
    "timeout_seconds": 30,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
