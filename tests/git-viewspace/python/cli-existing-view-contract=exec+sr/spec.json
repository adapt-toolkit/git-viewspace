{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::git-viewspace::cli-existing-view-contract",
  "labels": [],
  "prerequisites": [
    "command:git",
    "command:python3"
  ],
  "config": {
    "argv": [
      "python3",
      "-m",
      "unittest",
      "tests.test_stage2.Stage2Test.test_cli_exposes_view_identity_guard_on_existing_view_verbs_only",
      "tests.test_stage2.Stage2Test.test_cli_dispatches_conditional_destroy_and_validates_view_id"
    ],
    "cwd": {
      "anchor": "repository",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "apps/git-viewspace",
        "TMPDIR": "{workspace}"
      }
    },
    "timeout_seconds": 30,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
