{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::git-viewspace::daemon-startup-and-shutdown",
  "labels": [],
  "prerequisites": [
    "command:git",
    "command:python3"
  ],
  "config": {
    "argv": [
      "python3",
      "-m",
      "unittest",
      "tests.test_stage2.Stage2Test.test_start_publishes_nonready_runtime_before_restoring_views",
      "tests.test_stage2.Stage2Test.test_failed_start_closes_bound_socket_and_removes_runtime",
      "tests.test_stage2.Stage2Test.test_failed_start_preserves_runtime_when_mount_cleanup_fails",
      "tests.test_stage2.Stage2Test.test_shutdown_continues_when_nonready_runtime_write_fails"
    ],
    "cwd": {
      "anchor": "repository",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "apps/git-viewspace",
        "TMPDIR": "{workspace}"
      }
    },
    "timeout_seconds": 30,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
