{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::git-viewspace::init-state-and-locking",
  "labels": [],
  "prerequisites": [
    "command:git",
    "command:python3"
  ],
  "config": {
    "argv": [
      "python3",
      "-m",
      "unittest",
      "tests.test_init.InitTest.test_busy_root_lock_is_rejected",
      "tests.test_init.InitTest.test_unexplained_completed_root_entry_is_rejected",
      "tests.test_init.InitTest.test_completed_initialization_rejects_changed_arguments",
      "tests.test_init.InitTest.test_strict_config_schema_blocks_idempotent_adoption"
    ],
    "cwd": {
      "anchor": "repository",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "apps/git-viewspace",
        "TMPDIR": "{workspace}"
      }
    },
    "timeout_seconds": 30,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
