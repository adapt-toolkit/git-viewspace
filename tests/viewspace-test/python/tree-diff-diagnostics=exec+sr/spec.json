{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::tree-diff-diagnostics",
  "labels": [],
  "prerequisites": [
    "command:python3"
  ],
  "config": {
    "argv": [
      "python3",
      "-m",
      "unittest",
      "utils.tests.test_viewspace_test_tree.TreeSupportTests.test_snapshot_diff_reports_executable_bit_changes",
      "utils.tests.test_viewspace_test_tree.TreeSupportTests.test_snapshot_diff_rejects_duplicates_instead_of_masking_them",
      "utils.tests.test_viewspace_test_tree.TreeSupportTests.test_snapshot_diff_reports_exact_content_and_shape_changes",
      "utils.tests.test_viewspace_test_tree.TreeSupportTests.test_snapshot_diff_reports_bounded_binary_offset_and_digests"
    ],
    "cwd": {
      "anchor": "repository",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "TMPDIR": "{workspace}"
      }
    },
    "timeout_seconds": 60,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
