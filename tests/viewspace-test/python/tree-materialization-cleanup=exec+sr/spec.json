{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::tree-materialization-cleanup",
  "labels": [],
  "prerequisites": [
    "command:python3"
  ],
  "config": {
    "argv": [
      "python3",
      "-m",
      "unittest",
      "utils.tests.test_viewspace_test_tree.TreeSupportTests.test_materialization_cleans_partial_output_on_failure"
    ],
    "cwd": {
      "anchor": "repository",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "TMPDIR": "{workspace}"
      }
    },
    "timeout_seconds": 60,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
