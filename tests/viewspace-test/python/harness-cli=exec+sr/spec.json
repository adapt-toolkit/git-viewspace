{
  "schema_version": 2,
  "scope": "full",
  "driver": "exec",
  "selector": "python::harness-cli",
  "labels": [],
  "prerequisites": [
    "command:python3",
    "linux"
  ],
  "config": {
    "argv": [
      "python3",
      "-m",
      "unittest",
      "utils.tests.test_viewspace_test.HarnessTests.test_cli_parser_exposes_golden_and_selection_controls",
      "utils.tests.test_viewspace_test.HarnessTests.test_default_inventory_never_builds_engine"
    ],
    "cwd": {
      "anchor": "repository",
      "path": "."
    },
    "environment": {
      "inherit": [
        "HOME",
        "PATH"
      ],
      "set": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "TMPDIR": "{workspace}"
      }
    },
    "timeout_seconds": 60,
    "compare": [
      "status"
    ],
    "filesystem": null
  }
}
